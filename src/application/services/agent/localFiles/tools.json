{
    "tools": [
        {
            "name": "create_role",
            "description": "Yeni bir rol oluşturur. Sisteme yeni yetki veya erişim rolü eklemek için kullanılır.",
            "parameters": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Yalnızca rol adını döndür. Rol adını çevreleyen kelimeleri ekleme. Çıktı sadece rol adından oluşmalıdır. Örnekler: 'Vekil rolünü oluştur' → 'Vekil', 'Muhasebe rolünü sil' → 'Muhasebe', 'Admin rolünü aktif et' → 'Admin'.Oluşturulacak rolün adı. Kullanıcının yazdığı değeri aynen al. Çeviri yapma, değiştirme veya yorumlama."
                    }
                },
                "required": [
                    "name"
                ]
            }
        },
        {
            "name": "update_role",
